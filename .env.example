# Copy this file to .env and replace both values with the credentials for the
# Supabase project this application should use. Do not commit the .env file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Keep server-only credentials unprefixed; Vite exposes VITE_* variables to browsers.
SUPABASE_SECRET_KEY=your-server-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
